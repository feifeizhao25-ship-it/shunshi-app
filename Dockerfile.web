FROM ghcr.io/cirruslabs/flutter:3.38.5 AS build

WORKDIR /app
ARG SHUNSHI_API_BASE_URL
RUN test -n "$SHUNSHI_API_BASE_URL" \
    && case "$SHUNSHI_API_BASE_URL" in https://*) ;; *) exit 1 ;; esac

COPY pubspec.yaml pubspec.lock ./
RUN flutter pub get
COPY . .
RUN flutter build web --release \
    --dart-define=SHUNSHI_API_BASE_URL="$SHUNSHI_API_BASE_URL"
RUN printf 'ok\n' > /app/build/web/healthz

FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build/web /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/healthz | grep -q '^ok$' || exit 1
