SHUNSHI_ENV=production
SHUNSHI_DATABASE_PATH=/data/shunshi.db
SHUNSHI_JWT_SECRET=replace-with-at-least-32-random-characters
SHUNSHI_CORS_ORIGINS=https://app.example.cn
SHUNSHI_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SHUNSHI_OPENAI_API_KEY=
SHUNSHI_OPENAI_BASE_URL=https://openrouter.ai/api/v1
SHUNSHI_OPENAI_MODEL=qwen/qwen3-30b-a3b-instruct-2507
OPENROUTER_FALLBACK_MODELS=deepseek/deepseek-v3.2,google/gemini-2.5-flash-lite
# 顺时包含健康数据；只有完成跨境合规评估并取得明确同意后才能开启。
SHUNSHI_LLM_ALLOW_CROSS_BORDER=false
OPENROUTER_CIRCUIT_FAILURES=3
OPENROUTER_CIRCUIT_COOLDOWN_SECONDS=60
SHUNSHI_AI_DAILY_LIMIT_FREE=20
SHUNSHI_AI_DAILY_LIMIT_MEMBER=200
SHUNSHI_IAP_VERIFY_URL=
SHUNSHI_IAP_VERIFY_TOKEN=
SHUNSHI_OPENAI_MODEL=qwen-plus
SHUNSHI_SMS_PROVIDER_URL=
SHUNSHI_SMS_PROVIDER_TOKEN=
SHUNSHI_APPLE_SHARED_SECRET=
SHUNSHI_GOOGLE_SERVICE_ACCOUNT_JSON=
